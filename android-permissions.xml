<!--
  Android manifest permission baseline for the native CRI-BLO build.
  Copy the <uses-permission> entries below into:
    android/app/src/main/AndroidManifest.xml
  inside <manifest>, above <application>.

  Keep this list intentionally minimal. Runtime permission requests must be
  performed sequentially by the app and handled through Android's native
  permission dialogs.
-->

<!-- Location: precise + approximate fallback -->
<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

<!-- Camera -->
<uses-permission android:name="android.permission.CAMERA" />
<uses-feature android:name="android.hardware.camera" android:required="false" />

<!-- Microphone: required only for CRI-BLO dictation/voice features -->
<uses-permission android:name="android.permission.RECORD_AUDIO" />

<!-- Connectivity -->
<uses-permission android:name="android.permission.INTERNET" />
<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

<!--
  Do NOT add contacts, SMS, Bluetooth, background location, broad storage,
  media-library or notification permissions unless a future native feature
  genuinely requires them. Photo/file selection should use Android's system
  picker / scoped APIs rather than broad storage access.
-->
